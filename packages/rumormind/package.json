{
  "name": "rumormind",
  "version": "0.1.0",
  "description": "Beliefs with provenance, trust and gossip decisions for rule-driven characters. Zero dependencies, deterministic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "author": "Madhav Sunil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maddy824/Rumourtown.git",
    "directory": "packages/rumormind"
  },
  "keywords": ["simulation", "npc", "gossip", "beliefs", "game-ai", "deterministic"],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/rumormind/test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
