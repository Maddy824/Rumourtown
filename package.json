{
  "name": "rumortown-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/rumortown",
    "build": "npm run build -w apps/rumortown",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/sim.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
