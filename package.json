{
  "name": "rumortown-monorepo",
  "description": "A village of 36 people who gossip, with a deterministic social simulation and a reusable TypeScript belief engine.",
  "author": "Madhav Sunil",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Maddy824/Rumourtown.git" },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/rumortown",
    "build": "npm run build -w apps/rumortown",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/sim.ts",
    "bench:slm:scenarios": "node --experimental-strip-types bench/slm/scenarios.ts",
    "bench:slm:probes": "node --experimental-strip-types bench/slm/probes.ts",
    "bench:slm:smoke": "vitest run --config bench/slm/vitest.config.ts",
    "agent:demo": "node examples/agent.mjs demo",
    "agent:serve": "node examples/agent.mjs serve",
    "agent:replay": "node examples/agent.mjs replay",
    "addon:draft": "node scripts/draft-addon.mjs",
    "alerts:setup": "node scripts/setup-alerts.mjs",
    "load:check": "node scripts/load-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
